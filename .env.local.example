# Copy to .env.local (ignored by Git). One line per variable, NAME=value, no quotes. docs/local.md has the steps.
# The sign-in secret: make it once with `scripts/local.sh setup` and keep it; a new one makes every password unusable.
ORBYN_AUTH_SETUP=
# Browser origins the API accepts (the Planner dev server, its preview, the desktop shell). Optional.
ORBYN_ALLOWED_ORIGINS=
