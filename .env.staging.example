# Copy to .env.staging on the staging host and fill it in. Never commit .env.staging, and never
# send its values through chat or a ticket. Every value is made on the host; how is below.
# One line per variable, NAME=value, with no quotes and no spaces. docs/staging.md has the rest.

# --- Required for the beta -----------------------------------------------------------------

# The database password. Letters and digits only, so it is safe inside a URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The sign-in secret. Make it once and keep it: a new one makes every password unusable, and
# the server and the worker must have the same value. Build the engine image first, then:
#   docker compose --env-file .env.staging -f compose.staging.yaml run --rm --no-deps server auth-setup
ORBYN_AUTH_SETUP=

# --- Real mail (before any tester is invited; docs/staging.md, "Before any tester is invited") ---

# Unset: staging writes each email address and code to the worker log (nothing is sent).
# For real mail set all three; the empty ORBYN_MAIL= line is what turns the log mode off.
#   ORBYN_MAIL=
#   ORBYN_SMTP_URL=smtps://resend:<API key>@smtp.resend.com:465
#   ORBYN_MAIL_FROM=Orbyn <hello@orbyn.dev>
ORBYN_SMTP_URL=
ORBYN_MAIL_FROM=

# --- The tunnel ----------------------------------------------------------------------------

# The staging tunnel's token, from Cloudflare (Zero Trust > Networks > Tunnels > the staging
# tunnel > Configure). Not the token orbyn.dev's tunnel uses. Empty: no tunnel, and staging is
# reachable on this host only.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional (the defaults are right unless a port is taken) ------------------------------

# Host ports, on 127.0.0.1 only. orbyn.dev's site uses 8080 on the same host, so these differ.
SERVER_PORT=
PLANNER_PORT=

# Where orbyn-planner is checked out, for the web image. Default ../orbyn-planner.
PLANNER_DIR=

# The cloudflared image. Default cloudflare/cloudflared:latest.
CLOUDFLARED_IMAGE=

# --- The smoke profile only (deploy-staging.sh --smoke) -------------------------------------

# The key service's Postgres: an owner role (migrations) and a runtime role (the service).
#   openssl rand -hex 24      (one for each)
KS_OWNER_PASSWORD=
KS_RUNTIME_PASSWORD=

# SoftHSM's two PINs: the one the key service uses, and the security officer's.
#   openssl rand -hex 12      (one for each)
KS_HSM_PIN=
KS_HSM_SO_PIN=
